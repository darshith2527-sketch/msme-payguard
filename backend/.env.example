# Leave as SQLite for quick start, or use Postgres from docker-compose:
# DATABASE_URL=postgresql+psycopg://payguard:payguard@localhost:5432/payguard
DATABASE_URL=sqlite:///./payguard.db

# RBI Bank Rate (%). Verify the current value on rbi.org.in before your demo.
RBI_BANK_RATE=5.75
DUE_SOON_DAYS=7

# Optional: any OpenAI-compatible endpoint to polish reminder letters
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:3000
